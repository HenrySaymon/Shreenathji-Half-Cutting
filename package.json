{
  "name": "shreenathji-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Shreenathji Half Cutting billing app (Android, Capacitor + SQLite)",
  "scripts": {
    "prep": "node scripts/prep.js",
    "sync": "npm run prep && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/sora": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2"
  }
}
